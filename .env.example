# Copying this file is optional. ./setup.sh writes .env.local automatically.
export H3_SERVE_PORT=8090
export H3_SERVE_HOST=127.0.0.1
# export H3_SERVE_API_KEY=replace-with-a-long-random-secret
# export H3_SERVE_MODEL_DIR=/path/to/models
# export H3_SERVE_PYTHON=/path/to/python
# export H3_SERVE_MINIMAX_SOURCE=/path/to/vendor/MiniMax-H3
# export H3_SERVE_LIGHTX_SOURCE=/path/to/vendor/LightX2V
# export X_MINIMAXH3_RUNTIME_ROOT=/root/x-minimaxh3-runtime

# Physical indices from nvidia-smi. Restart ./run.sh after changing the layout.
# auto enables two workers when the default SM89 cards are available.
# dual requires the configured cards; single uses the original one-GPU service.
# H3_GPU_MODE=dual
# H3_QWEN_GPUS=7,6,5,3
# H3_DIT_GPUS_FIRST=7,6
# H3_DIT_GPUS_SECOND=5,3
# H3_DECODE_GPUS=7,6,5,3
